{
  "name": "@cffnpwr/textlint-config",
  "version": "1.0.0",
  "private": false,
  "description": "Common textlint configuration for cffnpwr",
  "keywords": [
    "textlint",
    "textlintrc",
    "config",
    "japanese"
  ],
  "homepage": "https://github.com/cffnpwr/textlint-config",
  "bugs": "https://github.com/cffnpwr/textlint-config/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/cffnpwr/textlint-config.git"
  },
  "license": "MIT",
  "author": "cffnpwr",
  "exports": {
    "./.textlintrc.json": "./.textlintrc.json",
    "./package.json": "./package.json"
  },
  "files": [
    ".textlintrc.json",
    ".prh.yml"
  ],
  "scripts": {
    "lint": "textlint --config .textlintrc.json README-ja.md"
  },
  "dependencies": {
    "@cffnpwr/textlint-rule-preset-ja-writing-extras": "1.1.1",
    "@textlint-ja/textlint-rule-no-dropping-i": "3.0.0",
    "@textlint-ja/textlint-rule-no-insert-dropping-sa": "2.0.1",
    "@textlint-ja/textlint-rule-no-insert-re": "1.0.2",
    "@textlint-ja/textlint-rule-no-synonyms": "1.3.0",
    "@textlint-ja/textlint-rule-preset-ai-writing": "1.7.0",
    "sudachi-synonyms-dictionary": "20.0.0",
    "textlint-plugin-latex2e": "1.2.1",
    "textlint-rule-ja-no-orthographic-variants": "2.0.0",
    "textlint-rule-no-mixed-zenkaku-and-hankaku-alphabet": "1.0.1",
    "textlint-rule-period-in-list-item": "1.0.1",
    "textlint-rule-prefer-tari-tari": "1.0.3",
    "textlint-rule-preset-ja-spacing": "3.0.4",
    "textlint-rule-preset-ja-technical-writing": "12.0.2",
    "textlint-rule-prh": "6.1.1"
  },
  "devDependencies": {
    "textlint": "15.8.0"
  },
  "peerDependencies": {
    "textlint": "15.8.0"
  }
}
